<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.3.0.0</Version>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>KRWardrobeCleaner</AssemblyName>
    <RootNamespace>KRWardrobeCleaner</RootNamespace>
    <Author>yaaung-ai</Author>
    <Name>한국판 옷장 정리기</Name>
    <Punchline>한국판 환상의 옷장을 장롱 기준으로 자동 정리합니다.</Punchline>
    <Description>Dungeon Drip 스냅샷을 읽어 장롱에 보관 가능한 환상의 옷장 아이템을 찾고, 안전 검사를 거쳐 순차 복원하며 AutoRetainer 장롱 보관과 연동합니다.</Description>
    <RepoUrl>https://github.com/yaaung-ai/KRWardrobeCleaner</RepoUrl>
    <Tags>glamour;inventory;armoire;utility</Tags>
  </PropertyGroup>
</Project>
