<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.1.0.0</Version>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <AssemblyName>KRWardrobeCleaner</AssemblyName>
    <RootNamespace>KRWardrobeCleaner</RootNamespace>
    <Author>yaaung-ai</Author>
    <Name>KR Wardrobe Cleaner</Name>
    <Punchline>KR-client Glamour Dresser cleanup helper and calibration recorder.</Punchline>
    <Description>Reads Dungeon Drip snapshots, lists Armoire-eligible Glamour Dresser items, records KR-client dresser UI events for safe automation calibration, and exports diagnostics.</Description>
    <RepoUrl>https://github.com/yaaung-ai/KRWardrobeCleaner</RepoUrl>
    <Tags>glamour;inventory;armoire;utility</Tags>
  </PropertyGroup>
</Project>
